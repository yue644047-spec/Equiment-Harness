# =============================================================================
#  Dify 内网私有化部署（无 Docker）—— 配置填写表
# -----------------------------------------------------------------------------
#  用法：
#    1) 复制本文件为同目录下的  dify.env
#    2) 只需填写下面所有带 【填】 的行；带  (自动)  的行由安装脚本自动生成，留空即可
#    3) 本文件是整套部署唯一的参数入口，改完直接执行 vm/install.sh
#  对应 Dify 版本：1.17.1        目标系统：CentOS 7 / RHEL 8 / openEuler x86_64
# =============================================================================

# =============================================================================
# 第 1 部分 · 访问地址（使用者用浏览器打开哪个地址）
# =============================================================================
# 【填1】这台 VM 的 IP 或内网域名。注意：填 IP 就直接写 IP，不要带 http://
DIFY_HOST=192.168.1.100

# 【填2】对外访问端口。默认 80；若 80 被占用（如已有别的站点）改成 8080 等
DIFY_HTTP_PORT=80

# 【填3】是否启用 HTTPS：yes / no。内网无证书就填 no，后续想加密再加
DIFY_ENABLE_HTTPS=no

# 【自动】下面两行由脚本按上面自动推导，不要改
CONSOLE_API_URL=http://${DIFY_HOST}:${DIFY_HTTP_PORT}
CONSOLE_WEB_URL=http://${DIFY_HOST}:${DIFY_HTTP_PORT}
SERVICE_API_URL=http://${DIFY_HOST}:${DIFY_HTTP_PORT}
APP_API_URL=http://${DIFY_HOST}:${DIFY_HTTP_PORT}
APP_WEB_URL=http://${DIFY_HOST}:${DIFY_HTTP_PORT}
FILES_URL=http://${DIFY_HOST}:${DIFY_HTTP_PORT}
NEXT_PUBLIC_SOCKET_URL=ws://${DIFY_HOST}:${DIFY_HTTP_PORT}

# =============================================================================
# 第 2 部分 · 安装路径与账号（一次性设定，装完不要改）
# =============================================================================
# 【填4】安装根目录，所有组件都装在这里。磁盘建议 ≥50G 可用
DIFY_ROOT=/opt/dify
# 【填5】数据目录（数据库、上传文件、插件）。生产建议独立挂载盘
DIFY_DATA_ROOT=/data/dify

# 【填6】Dify 控制台管理员初始密码（首次登录用，登录后请立即改）
#       要求：至少 8 位，含大小写字母和数字
INIT_PASSWORD=ChangeMe_2026

# 【自动】以下五个密钥由安装脚本用 openssl 随机生成（留空即可，勿手填）
SECRET_KEY=
DB_PASSWORD=
REDIS_PASSWORD=
PLUGIN_DAEMON_KEY=
PLUGIN_DIFY_INNER_API_KEY=

# =============================================================================
# 第 3 部分 · 模型网关（★ 最关键：内网大模型接入点，填错整套问答就不可用）
# -----------------------------------------------------------------------------
#  说明：内网已有一个 OpenAI 兼容的模型网关。下面四项是安装脚本写入的
#        默认值；装完后还需要在 Dify 控制台里"安装插件 → 填一次"，见
#        deploy/04-配置填写清单.md 第 3 节。
# =============================================================================
# 【填7】模型网关地址（OpenAI 兼容），必须以 /v1 结尾
MODEL_GATEWAY_BASE_URL=http://10.0.0.20:8000/v1

# 【填8】模型网关的 API Key（没有鉴权就填 sk-noauth 占位）
MODEL_GATEWAY_API_KEY=sk-xxxxxxxxxxxxxxxx

# 【填9】对话模型名（用于智能问答助手）。填网关 /v1/models 里列出的准确名字
MODEL_CHAT=deepseek-v3

# 【填10】评价/标注用的高质量模型名（可以是同一个；对判断力要求高，建议用更强的）
MODEL_CHAT_ADVANCED=deepseek-v3

# 【填11】Embedding 模型名（★ 没有它知识库无法建索引，整套系统就是空的）
MODEL_EMBEDDING=bge-m3

# 【填12】Embedding 向量维度（必须与上面模型一致，填错会导致检索全空）
#        常见值：bge-m3=1024、bge-large-zh=1024、text-embedding-3-small=1536
EMBEDDING_DIM=1024

# 【填13】Rerank 模型名。网关没有 rerank 接口就填 none，系统会自动关闭重排
MODEL_RERANK=bge-reranker-v2-m3

# =============================================================================
# 第 4 部分 · 中间件连接（本机安装，一般不用改）
# =============================================================================
DB_TYPE=postgresql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=dify
DB_DATABASE=dify
DB_PLUGIN_DATABASE=dify_plugin

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_USE_SSL=false

# 向量库：pgvector（复用本机 PostgreSQL，不额外装服务）
VECTOR_STORE=pgvector
PGVECTOR_HOST=127.0.0.1
PGVECTOR_PORT=5432
PGVECTOR_USER=dify
PGVECTOR_DATABASE=dify
PGVECTOR_MIN_CONNECTION=2
PGVECTOR_MAX_CONNECTION=20

# =============================================================================
# 第 5 部分 · 离线与安全开关（隔离网必须这样设，不要改）
# =============================================================================
# 关闭插件市场，否则界面会一直尝试连 marketplace.dify.ai 而超时
MARKETPLACE_ENABLED=false
MARKETPLACE_API_URL=
MARKETPLACE_URL=
# 关闭插件签名强制校验（离线手工搬运的插件包没有官方签名时要用）
FORCE_VERIFYING_SIGNATURE=false
# 代码沙箱：代码节点（评分/标注工作流）必须靠它执行
CODE_EXECUTION_ENDPOINT=http://127.0.0.1:8194
SANDBOX_ENABLE_NETWORK=false
# SSRF 代理：离线内网不需要，关掉可少一个进程
SSRF_PROXY_HTTP_URL=
SSRF_PROXY_HTTPS_URL=

# =============================================================================
# 第 6 部分 · 容量与并发（按"上百人使用"预设，VM 少于 8C16G 请下调）
# =============================================================================
# 【填14】VM 的 CPU 核数（脚本按它自动算 worker 数；填错只是性能不最优）
VM_CPU_CORES=8
# 【填15】VM 的内存 GB（脚本按它自动调 PostgreSQL 参数）
VM_MEM_GB=16

GUNICORN_WORKERS=4
CELERY_WORKER_AMOUNT=4
CELERY_WORKER_CLASS=gevent
CODE_EXECUTION_POOL_MAX_CONNECTIONS=100
SANDBOX_MAX_WORKERS=4
PLUGIN_DAEMON_WORKERS=4

# =============================================================================
# 第 7 部分 · 安装所需的本机工具（由离线包自带，填 no 表示系统已有）
# =============================================================================
# 目标机没有 gcc/make 时，脚本会用离线包里的便携工具链（zig + go）编译
USE_BUNDLED_TOOLCHAIN=yes
# 是否用离线包里的 PostgreSQL 源码在本机编译安装（推荐 yes，保证与系统 glibc 匹配）
PG_BUILD_FROM_SOURCE=yes

# =============================================================================
#  填写完成后的自查（3 条，逐条确认）
#   1. 【填7】地址在 VM 上执行 curl -s http://网关IP:端口/v1/models -H "Authorization: Bearer 你的Key" 能返回模型列表
#   2. 【填11/12】Embedding 模型名与维度必须来自同一个模型，维度填错知识库检索会全空
#   3. 【填1】DIFY_HOST 填的是使用者浏览器能访问到的地址，不是 127.0.0.1
# =============================================================================
