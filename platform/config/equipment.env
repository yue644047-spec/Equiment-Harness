# 装备数据治理 · 统一配置（两个内核共用；门户可在线改写模型段）
# 口径：docs/16 ADR-D23。改这里即可换模型/换引擎源码位置，不需要改代码。

# ---------- 引擎内核位置 ----------
EQUIPMENT_HOME=D:\app\dify\platform
EQUIPMENT_DATA=D:\app\dify\platform\data
KNOWLEDGE_SOURCE=E:\llm-stack\src\ragflow-py
KNOWLEDGE_PYTHON=E:\llm-stack\src\ragflow-py\.venv\Scripts\python.exe
KNOWLEDGE_NLTK_DATA=E:\llm-stack\data\nltk_data
ORCHESTRATION_SOURCE=E:\llm-stack\src\dify\api
ORCHESTRATION_PYTHON=E:\llm-stack\src\dify\api\.venv\Scripts\python.exe

# ---------- 产品服务（一个进程 = 一个完整产品） ----------
PRODUCT_HOST=127.0.0.1
PRODUCT_PORT=8095
PRODUCT_SECRET=equipment-governance-2026-hys
# 账号：用户名:口令:显示名:角色（admin=可写，auditor=可写，user=只读）
PRODUCT_USERS=admin:admin123:系统管理员:admin,auditor:audit123:质量审核员:auditor,guest:guest123:业务用户:user
# 门户构建产物目录（前端静态文件，由产品服务托管）
PORTAL_DIST=D:\llm-stack\src\portal\web-modao\equipment-portal.vue\dist

# ---------- 进程资源管理器（阈值告警） ----------
# 单进程 CPU% 与内存 MB 的告警阈值（页面上可临时覆盖；超阈值高亮并进 alerts）
EQUIPMENT_PROCESS_CPU_THRESHOLD=80
EQUIPMENT_PROCESS_MEM_THRESHOLD_MB=4096

# ---------- 网关（内核调试用，可选） ----------
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8190

# ---------- 模型提供商（url + api key；两个内核共用） ----------
# 对话模型
MODEL_CHAT_PROVIDER=deepseek
MODEL_CHAT_NAME=deepseek-chat
MODEL_CHAT_BASE_URL=https://api.deepseek.com/v1
MODEL_CHAT_API_KEY=sk-5ee877b1ddb14d468755dbf09877293d
MODEL_CHAT_MAX_TOKENS=2048
# 本机 Ollama（模型提供商页也会读它列已安装模型）
OLLAMA_BASE=http://127.0.0.1:11434
# 嵌入模型（本机 Ollama / GPU）
MODEL_EMBEDDING_PROVIDER=ollama
MODEL_EMBEDDING_NAME=bge-m3
MODEL_EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
MODEL_EMBEDDING_API_KEY=ollama
MODEL_EMBEDDING_DIM=1024
# 单条文本送入嵌入前截断的字符数（防止超长片段整篇失败）
MODEL_EMBEDDING_MAX_CHARS=6000
# ---------- 图数据库（Neo4j）----------
# 本机已有 3 个 Neo4j 实例（neo4j-gllm:7475/7688、neo4j-game、neo4j-novel），
# 本产品用独立实例 D:\neo4j-equipment（HTTP 7485 / Bolt 7695），互不影响。
GRAPH_BACKEND=neo4j
# 图谱问答启用策略：off/never 关；on/always 开；auto（默认）只对"哪些/涉及/对比/汇总/清单/跨文档"等
# 跨文档·多跳类问题启用（docs/16 D9·D15，与旧 BFF EXT_KB_USE_KG=auto 同口径）
KG_MODE=auto
NEO4J_URI=http://127.0.0.1:7485
NEO4J_USER=neo4j
NEO4J_PASSWORD=Equipment@2026
NEO4J_DATABASE=neo4j

# ---------- 代码节点沙箱（Dify sandbox 协议，用于编排里的代码节点） ----------
CODE_EXEC_ENDPOINT=http://127.0.0.1:8194
CODE_EXEC_API_KEY=dify-sandbox

# ---------- 模型插件 slim（LLM/工具节点经插件守护进程执行） ----------
# graphon 的 LLM / 工具节点不直连模型，而是经 dify-plugin-daemon-slim 调插件；
# 这里用 remote 模式直连本机已运行的插件守护进程（5002），由它托管 deepseek 插件。
# 说明：SLIM_BINARY_PATH 指向已构建的 slim 可执行文件；守护进程地址/密钥取自 Dify 侧配置。
SLIM_MODE=remote
SLIM_DAEMON_ADDR=http://127.0.0.1:5002
SLIM_DAEMON_KEY=lYkiYYT6owG+71oLerGzA7GXCgOT++6ovaezWAjpCjf+Sjc3ZtU+qUEi
SLIM_BINARY_PATH=D:\llm-stack\hot\dify-plugin-daemon-slim.exe
# 对话模型所属插件的唯一标识（决定 DSL 里 provider=langgenius/deepseek/deepseek 能否解析到插件）
MODEL_CHAT_PLUGIN_ID=langgenius/deepseek:0.0.24@9e12eef09973667f0eaf4f082af883167e1de88740b22e71e71488d020c3778a
MODEL_CHAT_MODE=chat

# 重排模型（模型角色 · rerank）。此前四项全空 → 门户「系统设置」长期显示
# 「缺失项：RERANK」，且产品检索链根本没有重排调用（docs/16 D53）。
# 现在指向本机重排服务 platform/rerank_server.py（OpenAI 兼容 /v1/rerank）。
MODEL_RERANK_PROVIDER=openai_compatible
MODEL_RERANK_NAME=bge-reranker-v2-m3
MODEL_RERANK_BASE_URL=http://127.0.0.1:8196/v1
# 本机重排服务的口令（服务端会校验 Authorization: Bearer；与 CODE_EXEC_API_KEY 同做法）
MODEL_RERANK_API_KEY=equipment-rerank-local

# ---------- 本地重排服务（BGE Reranker v2 m3）----------
# 独立 venv 运行（不污染产品/内核解释器）；模型权重放运行树，不进交付树。
# 启动：启动重排服务.bat（或 RERANK_PYTHON platform\rerank_server.py）
RERANK_HOST=127.0.0.1
RERANK_PORT=8196
RERANK_DEVICE=auto
RERANK_BATCH=16
RERANK_MAX_LENGTH=512
RERANK_API_KEY=equipment-rerank-local
RERANK_MODEL_PATH=E:\llm-stack\data\models\bge-reranker-v2-m3
RERANK_PYTHON=E:\llm-stack\src\rerank-py\.venv\Scripts\python.exe
# 检索侧重排：auto（配了就用，默认）/ off（只走混合检索）
RERANK_MODE=auto
# 重排候选池放大倍数（先放大召回再重排；与旧 BFF EXT_KB_RERANK_FACTOR 同口径）
RERANK_CANDIDATE_FACTOR=4
