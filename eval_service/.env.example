# Dify 问答质量评测服务 —— 凭据模板
# 用法：把本文件内容按需复制到 C:\Users\Administrator\.env（或任意路径，用 --env-file 指定）
# 说明：
#   1) 环境变量优先于本文件中的同名项；
#   2) 本文件只放模板，切勿写入任何真实密钥，也不要提交到代码仓库；
#   3) 只想离线体验，请直接加 --mock，无需填写任何凭据。

# Dify 部署地址（末尾不要带 /v1）
DIFY_BASE_URL=https://cloud.dify.ai

# 问答应用（Chatflow）的 Service API Key，形如 app-xxxxxxxx
DIFY_APP_API_KEY=

# 满意度评价工作流应用的 Service API Key，形如 app-xxxxxxxx
DIFY_EVAL_API_KEY=

# 知识库 API Key，形如 dataset-xxxxxxxx（可选，仅 kb-build 需要）
DIFY_KB_API_KEY=

# ---- 以下为可选调优项，不填则用默认值 ----
# 单次请求超时（秒），默认 60
# DIFY_TIMEOUT=60
# 可重试错误的最大重试次数，默认 3
# DIFY_MAX_RETRIES=3
# judge 默认并发数，默认 4
# DIFY_CONCURRENCY=4
# SQLite 数据库路径，默认 eval_service/data/eval.db
# EVAL_DB_PATH=D:\app\dify\eval_service\data\eval.db
# 报表输出目录，默认 eval_service/out
# EVAL_OUT_DIR=D:\app\dify\eval_service\out
# 自定义 .env 文件路径
# DIFY_ENV_FILE=C:\Users\Administrator\.env
